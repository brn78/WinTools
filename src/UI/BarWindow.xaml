<Window x:Class="WinTools.UI.BarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="WinTools" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ResizeMode="NoResize" ShowActivated="False" SizeToContent="Height"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="14" Foreground="{DynamicResource TextPrimary}"
        UseLayoutRounding="True" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="ClearType"
        AllowDrop="True" Width="1200">
  <Window.Resources>
    <!-- Un tasto della barra (il menu contestuale si riempie nel codice: dipende dal tipo di tasto) -->
    <DataTemplate x:Key="BarButtonTemplate">
      <Button Style="{StaticResource BarButtonStyle}" Tag="{Binding}" ToolTip="{Binding Tooltip}" Click="BarButton_Click" Opacity="{Binding DragOpacity}"
              MinWidth="{Binding MinWidth}" Padding="{Binding Pad}"
              PreviewMouseLeftButtonDown="BarButton_MouseDown" PreviewMouseMove="BarButton_MouseMove" PreviewMouseLeftButtonUp="BarButton_MouseUp"
              ContextMenuOpening="BarButton_ContextMenuOpening" AllowDrop="True" Drop="Buttons_Drop" DragOver="Buttons_DragOver">
        <Button.ContextMenu><ContextMenu/></Button.ContextMenu>
        <Border BorderBrush="{Binding DropBrush}" BorderThickness="2" CornerRadius="6" Margin="-7,-3" Padding="5,1">
          <Grid>
            <!-- separatore: una linea sottile al posto di icona ed etichetta -->
            <Border Width="1" Height="34" Background="{DynamicResource Divider}" Margin="1,0" Visibility="{Binding SeparatorVisibility}"/>
            <StackPanel Orientation="Vertical" MinWidth="40" Visibility="{Binding ContentVisibility}">
              <Grid Width="26" Height="26" HorizontalAlignment="Center">
                <Image Source="{Binding Icon}" Width="24" Height="24" Visibility="{Binding ImageVisibility}" RenderOptions.BitmapScalingMode="HighQuality"/>
                <TextBlock Style="{StaticResource Glyph}" Text="{Binding Glyph}" FontSize="20" Visibility="{Binding GlyphVisibility}" Foreground="{DynamicResource Accent}"/>
                <Border Visibility="{Binding GroupBadgeVisibility}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-5,-4"
                        Background="{DynamicResource BarFill}" CornerRadius="6" Padding="2,0">
                  <TextBlock Style="{StaticResource Glyph}" Text="&#xE70D;" FontSize="8" Foreground="{DynamicResource TextSecondary}"/>
                </Border>
              </Grid>
              <TextBlock Text="{Binding Label}" FontSize="11" Margin="0,3,0,0" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="96"
                         Visibility="{Binding LabelVisibility}" Foreground="{DynamicResource TextSecondary}"/>
            </StackPanel>
          </Grid>
        </Border>
      </Button>
    </DataTemplate>

    <!-- Un tasto dentro un contenitore (riga del menu a comparsa) -->
    <DataTemplate x:Key="GroupItemTemplate">
      <Button Style="{StaticResource SubtleButton}" HorizontalContentAlignment="Left" Tag="{Binding}" ToolTip="{Binding Tooltip}" Click="GroupItem_Click" Opacity="{Binding DragOpacity}"
              PreviewMouseLeftButtonDown="BarButton_MouseDown" PreviewMouseMove="BarButton_MouseMove" PreviewMouseLeftButtonUp="BarButton_MouseUp"
              ContextMenuOpening="GroupItem_ContextMenuOpening" Padding="{Binding GroupPad}" MinWidth="220" HorizontalAlignment="Stretch">
        <Button.ContextMenu><ContextMenu/></Button.ContextMenu>
        <Grid>
          <Border Height="1" Background="{DynamicResource Divider}" Margin="2,3" Visibility="{Binding SeparatorVisibility}"/>
          <StackPanel Orientation="Horizontal" Visibility="{Binding ContentVisibility}">
            <Grid Width="22" Height="22" Margin="0,0,12,0">
              <Image Source="{Binding Icon}" Width="20" Height="20" Visibility="{Binding ImageVisibility}" RenderOptions.BitmapScalingMode="HighQuality"/>
              <TextBlock Style="{StaticResource Glyph}" Text="{Binding Glyph}" FontSize="17" Visibility="{Binding GlyphVisibility}" Foreground="{DynamicResource Accent}"/>
            </Grid>
            <TextBlock Text="{Binding Label}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="260"/>
          </StackPanel>
        </Grid>
      </Button>
    </DataTemplate>

    <!-- Un risultato della ricerca -->
    <DataTemplate x:Key="ResultTemplate">
      <Grid Height="40">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="40"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Grid Width="28" Height="28" VerticalAlignment="Center" HorizontalAlignment="Left">
          <Image Source="{Binding Icon}" Width="26" Height="26" Visibility="{Binding ImageVisibility}" RenderOptions.BitmapScalingMode="HighQuality"/>
          <TextBlock Style="{StaticResource Glyph}" Text="{Binding Glyph}" FontSize="18" Visibility="{Binding GlyphVisibility}" Foreground="{DynamicResource Accent}"/>
        </Grid>
        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="4,0,12,0">
          <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" FontSize="14"/>
          <TextBlock Text="{Binding Subtitle}" TextTrimming="CharacterEllipsis" FontSize="11.5" Foreground="{DynamicResource TextSecondary}" Margin="0,1,0,0"/>
        </StackPanel>
        <TextBlock Grid.Column="2" Text="{Binding Meta}" VerticalAlignment="Center" FontSize="11.5" Foreground="{DynamicResource TextTertiary}" Margin="0,0,6,0"/>
      </Grid>
    </DataTemplate>
  </Window.Resources>

  <!-- Spazio per l'ombra; il resto della finestra è trasparente (e lascia passare i clic) -->
  <Grid x:Name="Root" Background="Transparent">
    <Border x:Name="Panel" HorizontalAlignment="Center" VerticalAlignment="Top" MinWidth="720"
            Background="{DynamicResource BarFill}" BorderBrush="{DynamicResource CardStroke}" BorderThickness="1,0,1,1" CornerRadius="0,0,10,10" Margin="0,0,0,14">
      <Border.RenderTransform><TranslateTransform x:Name="Slide"/></Border.RenderTransform>
      <Border.Effect><DropShadowEffect BlurRadius="18" ShadowDepth="4" Direction="270" Opacity="0.35" Color="#000000"/></Border.Effect>
      <DockPanel x:Name="DockHost" LastChildFill="True">

        <!-- ============================ RIGA DELLA BARRA ============================ -->
        <Grid x:Name="BarRow" DockPanel.Dock="Top" Height="64" Margin="10,4,10,4">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>

          <!-- ricerca -->
          <Border Grid.Column="0" x:Name="SearchHost" Width="320" Height="38" VerticalAlignment="Center" CornerRadius="6" BorderThickness="1"
                  Background="{DynamicResource ControlFill}" BorderBrush="{DynamicResource ControlStroke}">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="34"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <TextBlock Style="{StaticResource Glyph}" Text="&#xE721;" FontSize="15" Foreground="{DynamicResource TextSecondary}"/>
              <TextBlock Grid.Column="1" x:Name="SearchHint" Text="Cerca file, cartelle e app…" VerticalAlignment="Center" Margin="2,0,0,0"
                         Foreground="{DynamicResource TextTertiary}" FontSize="14.5" IsHitTestVisible="False"/>
              <TextBox Grid.Column="1" x:Name="SearchBox" Style="{StaticResource SearchBox}" Padding="0,0,0,0" FontSize="14.5" VerticalAlignment="Center"
                       TextChanged="SearchBox_TextChanged" PreviewKeyDown="SearchBox_PreviewKeyDown" GotKeyboardFocus="SearchBox_GotFocus" LostKeyboardFocus="SearchBox_LostFocus"/>
              <Button Grid.Column="2" x:Name="ClearSearch" Style="{StaticResource IconButton}" Width="30" Height="30" Margin="0,0,3,0" Visibility="Collapsed"
                      Click="ClearSearch_Click" ToolTip="Cancella">
                <TextBlock Style="{StaticResource Glyph}" Text="&#xE711;" FontSize="12"/>
              </Button>
            </Grid>
          </Border>

          <Border Grid.Column="1" Width="1" Height="32" Margin="12,0,6,0" Background="{DynamicResource Divider}" VerticalAlignment="Center"/>

          <!-- tasti (con la linea che indica dove finirà un tasto trascinato) -->
          <Grid Grid.Column="2">
            <ScrollViewer x:Name="ButtonsScroll" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled"
                          PreviewMouseWheel="ButtonsScroll_MouseWheel" AllowDrop="True" Drop="Buttons_Drop" DragOver="Buttons_DragOver">
              <ItemsControl x:Name="ButtonsList" ItemTemplate="{StaticResource BarButtonTemplate}" Height="56" HorizontalAlignment="Left">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
              </ItemsControl>
            </ScrollViewer>
            <Border x:Name="DropLine" Width="3" Height="44" CornerRadius="1.5" Background="{DynamicResource Accent}" HorizontalAlignment="Left" VerticalAlignment="Center"
                    Visibility="Collapsed" IsHitTestVisible="False"/>
          </Grid>

          <Button Grid.Column="3" Style="{StaticResource IconButton}" Click="AddButton_Click" ToolTip="Aggiungi un tasto (o trascina qui un file)" Margin="4,0,0,0"
                  ContextMenuOpening="AddButton_ContextMenuOpening">
            <Button.ContextMenu><ContextMenu/></Button.ContextMenu>
            <TextBlock Style="{StaticResource Glyph}" Text="&#xE710;" FontSize="14" Foreground="{DynamicResource TextSecondary}"/>
          </Button>

          <Border Grid.Column="4" Width="1" Height="32" Margin="6,0,6,0" Background="{DynamicResource Divider}" VerticalAlignment="Center"/>

          <!-- azioni -->
          <StackPanel Grid.Column="5" Orientation="Horizontal">
            <Button x:Name="PinButton" Style="{StaticResource IconButton}" Click="Pin_Click" ToolTip="Blocca la barra (sempre visibile)">
              <TextBlock x:Name="PinGlyph" Style="{StaticResource Glyph}" Text="&#xE718;" FontSize="15" Foreground="{DynamicResource TextSecondary}"/>
            </Button>
            <Button Style="{StaticResource IconButton}" Click="Settings_Click" ToolTip="Impostazioni">
              <TextBlock Style="{StaticResource Glyph}" Text="&#xE713;" FontSize="15" Foreground="{DynamicResource TextSecondary}"/>
            </Button>
            <Button Style="{StaticResource IconButton}" Click="Close_Click" ToolTip="Nascondi la barra (Esc)">
              <TextBlock Style="{StaticResource Glyph}" Text="&#xE70E;" FontSize="13" Foreground="{DynamicResource TextSecondary}"/>
            </Button>
          </StackPanel>
        </Grid>

        <!-- ============================ AVVISO ============================ -->
        <Border x:Name="Notice" DockPanel.Dock="Top" Visibility="Collapsed" CornerRadius="6" BorderThickness="1" Padding="12,8" Margin="12,2,12,8"
                Background="{DynamicResource InfoFill}" BorderBrush="{DynamicResource CardStroke}">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="NoticeIcon" Style="{StaticResource Glyph}" Text="&#xE946;" FontSize="16" Margin="0,0,10,0" Foreground="{DynamicResource InfoText}"/>
            <TextBlock Grid.Column="1" VerticalAlignment="Center" TextWrapping="Wrap">
              <Run x:Name="NoticeTitle" FontWeight="SemiBold"/> <Run x:Name="NoticeText" Foreground="{DynamicResource TextSecondary}"/>
            </TextBlock>
            <Button Grid.Column="2" x:Name="NoticeAction" Style="{StaticResource AccentButton}" MinHeight="28" Padding="12,3" Margin="12,0,0,0" Click="NoticeAction_Click" Visibility="Collapsed"/>
            <Button Grid.Column="3" Style="{StaticResource IconButton}" Width="28" Height="28" Margin="6,0,0,0" Click="NoticeClose_Click" ToolTip="Chiudi">
              <TextBlock Style="{StaticResource Glyph}" Text="&#xE711;" FontSize="11"/>
            </Button>
          </Grid>
        </Border>

        <!-- ============================ RISULTATI ============================ -->
        <Border x:Name="Results" Visibility="Collapsed" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource Divider}">
          <Grid>
            <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <ListBox x:Name="ResultsList" ItemTemplate="{StaticResource ResultTemplate}" MaxHeight="440" Margin="6,6,6,2"
                     ScrollViewer.VerticalScrollBarVisibility="Auto" PreviewMouseLeftButtonUp="ResultsList_MouseUp"
                     PreviewMouseRightButtonUp="ResultsList_RightClick" KeyDown="ResultsList_KeyDown">
              <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                  <Setter Property="Padding" Value="8,2"/>
                </Style>
              </ListBox.ItemContainerStyle>
            </ListBox>
            <Grid Grid.Row="1" Margin="18,2,16,8">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <TextBlock x:Name="StatusText" Style="{StaticResource TxtCaption}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
              <TextBlock Grid.Column="1" x:Name="HintText" Style="{StaticResource TxtCaption}" Text="↑↓ scegli · Invio apri · Ctrl+Invio apri la cartella · Esc chiudi" VerticalAlignment="Center" Margin="12,0,0,0"/>
            </Grid>
          </Grid>
        </Border>
      </DockPanel>
    </Border>

    <!-- ============================ FANTASMA DEL TASTO TRASCINATO ============================ -->
    <Popup x:Name="Ghost" Placement="Absolute" AllowsTransparency="True" PopupAnimation="None" IsHitTestVisible="False" Focusable="False">
      <Border Background="{DynamicResource BarFill}" BorderBrush="{DynamicResource Accent}" BorderThickness="1" CornerRadius="8" Padding="12,6" Opacity="0.92" IsHitTestVisible="False">
        <Border.Effect><DropShadowEffect BlurRadius="12" ShadowDepth="3" Opacity="0.4" Color="#000000"/></Border.Effect>
        <StackPanel Orientation="Horizontal">
          <Grid Width="24" Height="24" Margin="0,0,8,0">
            <Image x:Name="GhostImage" Width="22" Height="22" RenderOptions.BitmapScalingMode="HighQuality"/>
            <TextBlock x:Name="GhostGlyph" Style="{StaticResource Glyph}" FontSize="18" Foreground="{DynamicResource Accent}"/>
          </Grid>
          <TextBlock x:Name="GhostLabel" VerticalAlignment="Center" MaxWidth="200" TextTrimming="CharacterEllipsis"/>
        </StackPanel>
      </Border>
    </Popup>

    <!-- ============================ MENU DI UN CONTENITORE ============================ -->
    <Popup x:Name="GroupPopup" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade" Placement="Bottom" VerticalOffset="4"
           Opened="GroupPopup_Opened" Closed="GroupPopup_Closed">
      <Border Background="{DynamicResource DialogFill}" BorderBrush="{DynamicResource CardStroke}" BorderThickness="1" CornerRadius="8" Padding="6" Margin="8"
              AllowDrop="True" Drop="GroupPopup_Drop" DragOver="GroupPopup_DragOver">
        <Border.Effect><DropShadowEffect BlurRadius="14" ShadowDepth="3" Direction="270" Opacity="0.35" Color="#000000"/></Border.Effect>
        <StackPanel>
          <TextBlock x:Name="GroupTitle" Style="{StaticResource TxtCaption}" Margin="10,4,10,6"/>
          <Grid>
            <ItemsControl x:Name="GroupList" ItemTemplate="{StaticResource GroupItemTemplate}"/>
            <Border x:Name="GroupDropLine" Height="3" CornerRadius="1.5" Background="{DynamicResource Accent}" VerticalAlignment="Top" Margin="6,0"
                    Visibility="Collapsed" IsHitTestVisible="False"/>
          </Grid>
          <TextBlock x:Name="GroupEmpty" Text="Vuoto: trascina qui un tasto della barra, oppure usa «Sposta in» dal tasto destro." Style="{StaticResource TxtCaption}"
                     TextWrapping="Wrap" MaxWidth="240" Margin="10,2,10,6" Visibility="Collapsed"/>
        </StackPanel>
      </Border>
    </Popup>
  </Grid>
</Window>
