<Window x:Class="WinTools.UI.ButtonEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tasto della barra" Width="640" Height="840" MinWidth="560" MinHeight="620" ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen" ShowInTaskbar="False">
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Margin="24,18,24,6">
      <TextBlock x:Name="Heading" Text="Nuovo tasto" Style="{StaticResource TxtSubtitle}"/>
      <TextBlock Text="Un programma, un file, una cartella, un indirizzo web o un comando. Puoi anche partire da uno strumento di Windows." Style="{StaticResource TxtSecondary}" TextWrapping="Wrap" Margin="0,4,0,0"/>
    </StackPanel>

    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24,6,24,8">
      <StackPanel>
        <Border Style="{StaticResource Card}" Padding="16,12" Margin="0,0,0,8">
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock Text="Contenitore di tasti"/>
              <TextBlock Text="Non apre nulla: un clic mostra un menu con i tasti che ci metti dentro (trascinandoli sopra o con «Sposta in»)." Style="{StaticResource TxtCaption}" TextWrapping="Wrap" Margin="0,2,0,0"/>
            </StackPanel>
            <ToggleButton Grid.Column="1" x:Name="GroupBox" Style="{StaticResource ToggleSwitch}" VerticalAlignment="Center" Margin="12,0,0,0" Checked="GroupBox_Changed" Unchecked="GroupBox_Changed"/>
          </Grid>
        </Border>

        <Border x:Name="PresetCard" Style="{StaticResource Card}" Padding="16,12">
          <StackPanel>
            <TextBlock Text="Strumento di Windows (facoltativo)" Style="{StaticResource TxtCaption}" Margin="0,0,0,4"/>
            <ComboBox x:Name="PresetBox" SelectionChanged="PresetBox_SelectionChanged"/>
          </StackPanel>
        </Border>

        <Border Style="{StaticResource Card}" Padding="16,12" Margin="0,8,0,0">
          <Grid x:Name="TargetGrid">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock Text="Etichetta" Style="{StaticResource TxtCaption}"/>
            <TextBox Grid.Row="1" x:Name="LabelBox" Margin="0,4,0,10" Grid.ColumnSpan="2" TextChanged="Any_Changed"/>

            <TextBlock Grid.Row="2" x:Name="TargetLabel" Text="Che cosa apre (programma, file, cartella, indirizzo, ms-settings:, shell:…)" Style="{StaticResource TxtCaption}"/>
            <TextBox Grid.Row="3" x:Name="TargetBox" Margin="0,4,8,10" TextChanged="Any_Changed"/>
            <StackPanel Grid.Row="3" Grid.Column="1" x:Name="BrowsePanel" Orientation="Horizontal" Margin="0,4,0,10">
              <Button Content="File…" Click="BrowseFile_Click" Padding="12,5"/>
              <Button Content="Cartella…" Click="BrowseFolder_Click" Padding="12,5" Margin="6,0,0,0"/>
            </StackPanel>

            <TextBlock Grid.Row="4" x:Name="ArgsLabel" Text="Argomenti (facoltativi)" Style="{StaticResource TxtCaption}"/>
            <TextBox Grid.Row="5" x:Name="ArgsBox" Margin="0,4,0,10" Grid.ColumnSpan="2"/>

            <TextBlock Grid.Row="6" x:Name="WorkDirLabel" Text="Cartella di lavoro (facoltativa)" Style="{StaticResource TxtCaption}"/>
            <TextBox Grid.Row="7" x:Name="WorkDirBox" Margin="0,4,0,2" Grid.ColumnSpan="2"/>
          </Grid>
        </Border>

        <!-- ============================ ICONA ============================ -->
        <Border Style="{StaticResource Card}" Padding="16,12" Margin="0,8,0,0">
          <StackPanel>
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <Border Width="56" Height="56" CornerRadius="8" Background="{DynamicResource ControlFill}" BorderBrush="{DynamicResource ControlStroke}" BorderThickness="1" Margin="0,0,16,0">
                <Grid>
                  <Image x:Name="PreviewImage" Width="28" Height="28" RenderOptions.BitmapScalingMode="HighQuality"/>
                  <Path x:Name="PreviewPath" Stretch="Uniform" Width="28" Height="28" Visibility="Collapsed"/>
                  <TextBlock x:Name="PreviewGlyph" Style="{StaticResource Glyph}" FontSize="24" Foreground="{DynamicResource Accent}"/>
                </Grid>
              </Border>
              <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Text="Icona" Style="{StaticResource TxtBodyStrong}"/>
                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                  <RadioButton x:Name="IconAuto" Content="Dal file" IsChecked="True" Checked="IconMode_Changed"/>
                  <RadioButton x:Name="IconGlyph" Content="Dal catalogo" Margin="18,0,0,0" Checked="IconMode_Changed"/>
                  <RadioButton x:Name="IconFile" Content="Immagine…" Margin="18,0,0,0" Checked="IconMode_Changed"/>
                </StackPanel>
              </StackPanel>
            </Grid>

            <!-- catalogo Material Design Icons con ricerca -->
            <StackPanel x:Name="GlyphPanel" Visibility="Collapsed" Margin="0,12,0,0">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBox x:Name="IconSearch" TextChanged="IconSearch_TextChanged" ToolTip="Scrivi in italiano o in inglese: interruttore, switch, cartella, rete, telecamera…"/>
                <TextBlock x:Name="IconHint" Grid.Column="0" Text="Cerca un'icona: switch, cartella, rete, telecamera…" Foreground="{DynamicResource TextTertiary}" VerticalAlignment="Center" Margin="12,0,0,0" IsHitTestVisible="False"/>
                <TextBlock x:Name="IconCount" Grid.Column="1" Style="{StaticResource TxtCaption}" VerticalAlignment="Center" Margin="12,0,0,0"/>
              </Grid>
              <ScrollViewer x:Name="IconScroll" Height="240" VerticalScrollBarVisibility="Auto" Margin="0,8,0,0">
                <WrapPanel x:Name="IconWrap"/>
              </ScrollViewer>
              <TextBlock Text="Colore" Style="{StaticResource TxtCaption}" Margin="0,10,0,4"/>
              <WrapPanel x:Name="ColorWrap"/>
            </StackPanel>

            <Grid x:Name="ImagePanel" Visibility="Collapsed" Margin="0,10,0,0">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <TextBox x:Name="ImageBox" TextChanged="Any_Changed"/>
              <Button Grid.Column="1" Content="Sfoglia…" Click="BrowseImage_Click" Margin="8,0,0,0" Padding="12,5"/>
            </Grid>

            <StackPanel x:Name="OptionsPanel" Orientation="Horizontal" Margin="0,12,0,0">
              <CheckBox x:Name="AdminBox" Content="Avvia come amministratore"/>
              <CheckBox x:Name="IconOnlyBox" Content="Solo icona, senza etichetta" Margin="24,0,0,0"/>
            </StackPanel>
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>

    <Border Grid.Row="2" Background="{DynamicResource DialogFooterFill}" BorderBrush="{DynamicResource Divider}" BorderThickness="0,1,0,0" Padding="24,14">
      <Grid>
        <TextBlock x:Name="FooterNote" Style="{StaticResource TxtCaption}" VerticalAlignment="Center" Text="Icone Material Design (Pictogrammers, Apache 2.0)"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <Button x:Name="OkButton" Content="Salva" Style="{StaticResource AccentButton}" MinWidth="110" Click="Ok_Click" IsDefault="True"/>
          <Button Content="Annulla" MinWidth="110" Margin="8,0,0,0" IsCancel="True"/>
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</Window>
